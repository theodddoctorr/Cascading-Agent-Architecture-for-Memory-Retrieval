# Auto detect text files and perform LF normalization
* text=auto

# Text files
*.md text
*.txt text
*.cff text
*.json text

# Binary files
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.flv binary
*.fla binary
*.swf binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.eot binary
*.woff binary
*.woff2 binary
*.pyc binary
*.class binary
*.so binary
*.dll binary
*.exe binary

# Scripts
*.sh text eol=lf
*.bash text eol=lf

# Ensure PDFs are handled efficiently
*.pdf diff=astextplain
*.pdf -text

# Export-ignore (files not included in archives)
.gitignore export-ignore
.gitattributes export-ignore
.github/ export-ignore
